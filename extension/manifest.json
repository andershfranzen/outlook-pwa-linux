{
  "manifest_version": 3,
  "name": "Outlook Integration",
  "version": "0.3.0",
  "description": "Integrates Outlook with Linux, checks for updates, and routes external links to the default browser.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://outlook.office.com/*",
    "https://outlook.live.com/*"
  ],
  "background": {
    "service_worker": "background-v030.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.live.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.json",
        "a5-settings.svg"
      ],
      "matches": [
        "https://outlook.office.com/*",
        "https://outlook.live.com/*"
      ]
    }
  ]
}
