    def current_profile(self) -> dict[str, object]:
        return self.settings["profiles"][self.profile_id]

    def rebuild_profile_model(self, selected: str) -> None:
        self.profile_ids = list(self.settings["profiles"])
        names = [
            str(self.settings["profiles"][profile_id]["name"])
            for profile_id in self.profile_ids
        ]
        self.profile_combo.set_model(string_model(names))
        self.profile_combo.set_selected(self.profile_ids.index(selected))

    def load_profile(self, profile_id: str) -> None:
        self.loading = True
        self.profile_id = profile_id
        profile = self.current_profile()
        self.name_row.set_text(str(profile["name"]))
        self.start_view_row.set_selected(
            VIEW_KEYS.index(str(profile["start_view"]))
        )
        self.focus_row.set_active(bool(profile["focus_mode"]))
        self.ask_download_row.set_active(bool(profile["ask_download"]))
        self.download_row.set_subtitle(str(profile["download_directory"]))

        style = str(self.settings["titlebar_style"])
        self.style_row.set_selected(STYLE_KEYS.index(style))
        rgba = Gdk.RGBA()
        rgba.parse(str(self.settings["titlebar_color"]))
        self.color_button.set_rgba(rgba)
        self.color_row.set_visible(style == "custom")

        self.external_row.set_active(bool(self.settings["route_external_links"]))
        self.mailto_row.set_active(bool(self.settings["mailto_handler"]))
        self.autostart_row.set_active(bool(self.settings["autostart"]))
        is_default = profile_id == self.settings["default_profile"]
        self.default_button.set_label("Default" if is_default else "Make Default")
        self.default_button.set_sensitive(not is_default)
        custom_icon = str(profile["custom_icon"])
        self.icon_row.set_subtitle(
            Path(custom_icon).name if custom_icon else "Official Outlook icon"
        )
        self.icon_reset_button.set_sensitive(bool(custom_icon))
        self.remove_row.set_sensitive(len(self.profile_ids) > 1)

        profile_path = user_data_dir() / str(profile["edge_profile"])
        self.storage_row.set_subtitle(format_size(profile_size(profile)))
        self.path_row.set_subtitle(str(profile_path))
        self.loading = False

    def save(self, message: str | None = None) -> None:
        if self.loading:
            return
        try:
            save_settings(self.settings)
            apply_user_integration(self.settings)
        except OSError as error:
            self.toast(f"Could not save settings: {error}")
            return
        if message:
            self.toast(message)

    def toast(self, message: str) -> None:
        self.toast_overlay.add_toast(Adw.Toast.new(message))

    def set_update_busy(self, busy: bool, status: str | None = None) -> None:
        self.update_busy = busy
        self.update_spinner.set_visible(busy)
        self.update_spinner.set_spinning(busy)
        self.check_update_button.set_sensitive(not busy)
        self.update_button.set_sensitive(not busy)
        if status:
            self.update_row.set_subtitle(status)

    def start_update_check(self, force: bool) -> bool:
        if self.update_busy:
            return False
        self.update_button.set_visible(False)
        self.set_update_busy(True, "Checking for updates…")
        threading.Thread(
            target=self.check_update_worker,
            args=(force,),
            daemon=True,
            name="outlook-update-check",
        ).start()
        return False

    def check_update_worker(self, force: bool) -> None:
        try:
            release = check_for_update(force=force)
        except UpdateError as error:
            GLib.idle_add(self.finish_update_check, None, str(error))
            return
        GLib.idle_add(self.finish_update_check, release, None)

    def finish_update_check(
        self, release: Release | None, error: str | None
    ) -> bool:
        self.set_update_busy(False)
        if error:
            self.update_release = None
            self.update_row.set_subtitle(f"Could not check for updates — {error}")
            return False
        assert release is not None
        self.update_release = release
        if release.available:
            self.update_row.set_subtitle(
                f"Version {release.version} is ready to install"
            )
            self.update_button.set_label(f"Update to {release.version}")
            self.update_button.set_visible(True)
        else:
            self.update_row.set_subtitle(
                f"Up to date · checked at {format_checked_time()}"
            )
            self.update_button.set_visible(False)
        return False

    def on_update_action(self, _button) -> None:
        if self.update_installed_version:
            self.restart_outlook()
            return
        if not self.update_release or not self.update_release.available:
            return
        dialog = Adw.AlertDialog()
        dialog.set_heading(f"Update Outlook to {self.update_release.version}?")
        dialog.set_body(
            "The package will be downloaded from the project’s immutable "
            "GitHub release, verified twice, and installed after administrator "
            "authentication. Your Outlook profiles and settings are kept."
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("update", "Download and Update")
        dialog.set_close_response("cancel")
        dialog.set_default_response("update")
        dialog.set_response_appearance(
            "update", Adw.ResponseAppearance.SUGGESTED
        )
        dialog.connect("response", self.finish_update_confirmation)
        dialog.present(self)

    def finish_update_confirmation(self, _dialog, response: str) -> None:
        if response != "update" or not self.update_release:
            return
        release = self.update_release
        self.update_button.set_visible(False)
        self.set_update_busy(True, f"Downloading Outlook {release.version}…")
        threading.Thread(
            target=self.install_update_worker,
            args=(release,),
            daemon=True,
            name="outlook-update-install",
        ).start()

    def install_update_worker(self, release: Release) -> None:
        try:
            package_path = download_update(release)
            GLib.idle_add(
                self.update_row.set_subtitle,
                "Verified · waiting for administrator authentication…",
            )
            install_update(release, package_path)
            launcher = shutil.which("outlook-pwa") or "/usr/bin/outlook-pwa"
            subprocess.run(
                (launcher, "--reconcile-launchers"),
                check=False,
                capture_output=True,
                timeout=30,
            )
        except (OSError, subprocess.SubprocessError, UpdateError) as error:
            GLib.idle_add(self.finish_update_install, None, str(error))
            return
        GLib.idle_add(self.finish_update_install, release.version, None)

    def finish_update_install(
        self, version: str | None, error: str | None
    ) -> bool:
        self.set_update_busy(False)
        if error:
            self.update_row.set_subtitle(f"Update failed — {error}")
            self.update_button.set_label("Try Again")
            self.update_button.set_visible(bool(self.update_release))
            return False
        assert version is not None
        self.update_installed_version = version
        self.update_row.set_title(f"Outlook {version}")
        self.update_row.set_subtitle(
            "Update installed · restart Outlook to finish"
        )
        self.update_button.set_label("Restart Outlook")
        self.update_button.set_visible(True)
        self.check_update_button.set_visible(False)
        self.toast(f"Outlook {version} is installed")
        return False

    def restart_outlook(self) -> None:
        launcher = shutil.which("outlook-pwa") or "/usr/bin/outlook-pwa"
        try:
            subprocess.Popen(
                (launcher, "--restart", "--profile", self.profile_id),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError as error:
            self.toast(f"Could not restart Outlook: {error}")
            return
        application = self.get_application()
        if application:
            application.quit()

    def on_profile_selected(self, row, _spec) -> None:
        if self.loading or row.get_selected() >= len(self.profile_ids):
            return
        self.load_profile(self.profile_ids[row.get_selected()])

    def on_name_changed(self, row) -> None:
        if self.loading:
            return
        name = row.get_text().strip()
        if not name:
            return
        self.current_profile()["name"] = name
        model = self.profile_combo.get_model()
        if isinstance(model, Gtk.StringList):
            model.splice(self.profile_ids.index(self.profile_id), 1, [name])
        self.save()

    def on_start_view_changed(self, row, _spec) -> None:
        if self.loading:
            return
        self.current_profile()["start_view"] = VIEW_KEYS[row.get_selected()]
        self.save()

    def on_make_default(self, _button) -> None:
        self.settings["default_profile"] = self.profile_id
        self.default_button.set_label("Default")
        self.default_button.set_sensitive(False)
        self.save("Default Outlook profile changed")

    def on_add_profile(self, _row) -> None:
        profile_id, edge_profile = next_profile(self.settings)
        profile = deepcopy(default_settings()["profiles"]["default"])
        profile["name"] = (
            "Personal Outlook"
            if len(self.settings["profiles"]) == 1
            else f"Outlook {len(self.settings['profiles']) + 1}"
        )
        profile["edge_profile"] = edge_profile
        self.settings["profiles"][profile_id] = profile
        self.save("Outlook profile added")
        self.loading = True
        self.rebuild_profile_model(profile_id)
        self.loading = False
        self.load_profile(profile_id)

    def on_style_changed(self, row, _spec) -> None:
        if self.loading:
            return
        style = STYLE_KEYS[row.get_selected()]
        self.settings["titlebar_style"] = style
        self.color_row.set_visible(style == "custom")
        self.apply_header_style()
        self.save("Top-bar style saved — reopen Outlook to apply it")

    def on_color_changed(self, button, _spec) -> None:
        if self.loading:
            return
        rgba = button.get_rgba()
        self.settings["titlebar_color"] = (
            f"#{round(rgba.red * 255):02x}"
            f"{round(rgba.green * 255):02x}"
            f"{round(rgba.blue * 255):02x}"
        )
        if self.settings["titlebar_style"] == "custom":
            self.apply_header_style()
            self.save("Custom top-bar color saved — reopen Outlook to apply it")

    def on_focus_changed(self, row, _spec) -> None:
        if self.loading:
            return
        self.current_profile()["focus_mode"] = row.get_active()
        self.save()

    def on_external_changed(self, row, _spec) -> None:
        if self.loading:
            return
        self.settings["route_external_links"] = row.get_active()
        self.save("External link routing saved — reopen Outlook to apply it")

    def on_mailto_changed(self, row, _spec) -> None:
        if self.loading:
            return
        self.settings["mailto_handler"] = row.get_active()
        self.save("Email-link preference applied")

    def on_autostart_changed(self, row, _spec) -> None:
        if self.loading:
            return
        self.settings["autostart"] = row.get_active()
        self.save("Login startup preference applied")

    def on_ask_download_changed(self, row, _spec) -> None:
        if self.loading:
            return
        self.current_profile()["ask_download"] = row.get_active()
        self.save()

    def on_choose_download(self, _button) -> None:
        dialog = Gtk.FileDialog()
        dialog.set_title("Choose the Outlook download folder")
        initial = Gio.File.new_for_path(
            str(Path(str(self.current_profile()["download_directory"])).expanduser())
        )
        dialog.set_initial_folder(initial)
        dialog.select_folder(self, None, self.on_download_selected)

    def on_download_selected(self, dialog, result) -> None:
        try:
            folder = dialog.select_folder_finish(result)
        except GLib.Error:
            return
        path = folder.get_path()
        if not path:
            return
        self.current_profile()["download_directory"] = path
        self.download_row.set_subtitle(path)
        self.save("Download folder saved")

    def on_choose_icon(self, _button) -> None:
        dialog = Gtk.FileDialog()
        dialog.set_title("Choose a dock icon")
        image_filter = Gtk.FileFilter()
        image_filter.set_name("Images")
        image_filter.add_mime_type("image/png")
        image_filter.add_mime_type("image/jpeg")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(image_filter)
        dialog.set_filters(filters)
        dialog.set_default_filter(image_filter)
        dialog.open(self, None, self.on_icon_selected)

    def on_icon_selected(self, dialog, result) -> None:
        try:
            source_file = dialog.open_finish(result)
        except GLib.Error:
            return
        source = Path(source_file.get_path() or "")
        try:
            Gdk.Texture.new_from_filename(str(source))
            destination = (
                app_config_dir() / "custom-icons" / f"{self.profile_id}{source.suffix}"
            )
            destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
            shutil.copy2(source, destination)
            destination.chmod(0o600)
        except (GLib.Error, OSError) as error:
            self.toast(f"Could not use that image: {error}")
            return
        self.current_profile()["custom_icon"] = str(destination)
        self.icon_row.set_subtitle(destination.name)
        self.icon_reset_button.set_sensitive(True)
        self.save("Custom dock icon applied")

    def on_reset_icon(self, _button) -> None:
        path = Path(str(self.current_profile()["custom_icon"]))
        self.current_profile()["custom_icon"] = ""
        try:
            if path.is_file() and path.parent == app_config_dir() / "custom-icons":
                path.unlink()
        except OSError:
            pass
        self.icon_row.set_subtitle("Official Outlook icon")
        self.icon_reset_button.set_sensitive(False)
        self.save("Official Outlook icon restored")

    def on_launch(self, _button) -> None:
        executable = shutil.which("outlook-pwa") or str(
            Path(__file__).with_name("outlook-pwa")
        )
        subprocess.Popen(
            (executable, "--profile", self.profile_id),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    def on_repair(self, _row) -> None:
        changed = apply_user_integration(self.settings)
        self.toast(
            "Desktop integration repaired"
            if changed
            else "Desktop integration is already healthy"
        )

    def on_diagnostics(self, _row) -> None:
        profile = self.current_profile()
        data = {
            "version": VERSION,
            "selected_profile": self.profile_id,
            "default_profile": self.settings["default_profile"],
            "edge_profile": profile["edge_profile"],
            "profile_path": str(user_data_dir() / str(profile["edge_profile"])),
            "profile_size": format_size(profile_size(profile)),
            "edge_running": edge_is_running(),
            "top_bar": self.settings["titlebar_style"],
            "focus_mode": profile["focus_mode"],
            "external_links": self.settings["route_external_links"],
            "autostart": self.settings["autostart"],
        }
        dialog = Adw.AlertDialog()
        dialog.set_heading("Outlook diagnostics")
        dialog.set_body(json.dumps(data, indent=2))
        dialog.add_response("close", "Close")
        dialog.set_default_response("close")
        dialog.present(self)

    def confirm(self, heading: str, body: str, response, callback) -> None:
        dialog = Adw.AlertDialog()
        dialog.set_heading(heading)
        dialog.set_body(body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response(response, "Move to Trash" if response == "reset" else "Remove")
        dialog.set_close_response("cancel")
        dialog.set_default_response("cancel")
        dialog.set_response_appearance(response, Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", callback)
        dialog.present(self)

    def on_remove_profile(self, _row) -> None:
        if len(self.settings["profiles"]) <= 1:
            return
        name = self.current_profile()["name"]
        self.confirm(
            f"Remove {name}?",
            "Its launcher and settings will be removed. Existing browser data is "
            "kept until you reset it.",
            "remove",
            self.finish_remove_profile,
        )

    def finish_remove_profile(self, _dialog, response: str) -> None:
        if response != "remove":
            return
        old_profile = self.current_profile()
        remaining = [
            item for item in self.profile_ids if item != self.profile_id
        ]
        new_profile_id = remaining[0]
        if self.settings["default_profile"] == self.profile_id:
            self.settings["default_profile"] = new_profile_id
        del self.settings["profiles"][self.profile_id]
        remove_profile_integration(old_profile)
        self.profile_id = new_profile_id
        self.save("Outlook profile removed; browser data was kept")
        self.loading = True
        self.rebuild_profile_model(new_profile_id)
        self.loading = False
        self.load_profile(new_profile_id)

    def on_reset_profile(self, _row) -> None:
        if edge_is_running():
            self.toast("Close every Outlook window before resetting browser data")
            return
        name = self.current_profile()["name"]
        self.confirm(
            f"Reset {name}?",
            "This signs the profile out and moves its cookies, cache, and local "
            "browser data to the Trash.",
            "reset",
            self.finish_reset_profile,
        )

    def finish_reset_profile(self, _dialog, response: str) -> None:
        if response != "reset":
            return
        profile = self.current_profile()
        path = user_data_dir() / str(profile["edge_profile"])
        if not path.exists():
            self.toast("This profile has no browser data to reset")
            return
        try:
            Gio.File.new_for_path(str(path)).trash(None)
        except GLib.Error as error:
            self.toast(f"Could not move the profile to Trash: {error.message}")
            return
        self.storage_row.set_subtitle("0 B")
        self.toast("Profile data moved to Trash")


class SettingsApplication(Adw.Application):
    def __init__(self) -> None:
        GLib.set_application_name("Outlook")
        Gtk.Window.set_default_icon_name("outlook-pwa-linux")
        super().__init__(
            application_id="com.outlook_pwa_linux.settings",
            flags=Gio.ApplicationFlags.DEFAULT_FLAGS,
        )
        self.window: SettingsWindow | None = None

    def do_activate(self) -> None:
        if self.window is None:
            self.window = SettingsWindow(self)
        self.window.present()


def main() -> int:
    application = SettingsApplication()
    return application.run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
