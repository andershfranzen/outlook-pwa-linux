        super().__init__(application=application)
        self.set_title("Outlook")
        self.set_icon_name("outlook-pwa-linux")
        self.set_default_size(760, 780)
        self.set_size_request(540, 600)
        self.connect("map", self.on_map)

        self.settings = load_settings()
        self.profile_ids: list[str] = []
        self.profile_id = str(self.settings["default_profile"])
        self.loading = True
        self.update_busy = False
        self.update_release: Release | None = None
        self.update_installed_version: str | None = None

        self.toast_overlay = Adw.ToastOverlay()
        self.set_content(self.toast_overlay)
        toolbar = Adw.ToolbarView()
        self.toast_overlay.set_child(toolbar)

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle.new("Outlook", "Settings"))
        launch_header = Gtk.Button(
            icon_name="media-playback-start-symbolic",
            tooltip_text="Open the selected Outlook profile",
        )
        launch_header.add_css_class("suggested-action")
        launch_header.connect("clicked", self.on_launch)
        header.pack_end(launch_header)
        toolbar.add_top_bar(header)

        page = Adw.PreferencesPage()
        page.set_title("Outlook")
        page.set_icon_name("outlook-pwa-linux")
        toolbar.set_content(page)

        self.build_profiles_group(page)
        self.build_appearance_group(page)
        self.build_integration_group(page)
        self.build_downloads_group(page)
        self.build_updates_group(page)
        self.build_maintenance_group(page)
        self.build_footer(page)

        self.rebuild_profile_model(self.profile_id)
        self.load_profile(self.profile_id)
        self.apply_header_style()
        self.loading = False
        GLib.idle_add(self.start_update_check, False)

    def on_map(self, _window) -> None:
        surface = self.get_surface()
        if isinstance(surface, GdkWayland.WaylandToplevel):
            _, profile = get_profile(self.settings)
            surface.set_application_id(wayland_app_id(profile))

    def apply_header_style(self) -> None:
        if hasattr(self, "header_css"):
            Gtk.StyleContext.remove_provider_for_display(
                self.get_display(), self.header_css
            )
        color = effective_titlebar_color(self.settings)
        if not color:
            self.remove_css_class("outlook-colored-header")
            return
        self.add_css_class("outlook-colored-header")
        self.header_css = Gtk.CssProvider()
        self.header_css.load_from_string(
            f"""
            window.outlook-colored-header headerbar {{
                background-color: {color};
                background-image: none;
                color: white;
            }}
            window.outlook-colored-header headerbar button,
            window.outlook-colored-header headerbar windowcontrols {{
                color: white;
            }}
            """
        )
        Gtk.StyleContext.add_provider_for_display(
            self.get_display(),
            self.header_css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

