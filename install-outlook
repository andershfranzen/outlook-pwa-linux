#!/bin/sh
set -eu
umask 022

RELEASE_VERSION="0.2.9"
DEFAULT_REPOSITORY="andershfranzen/outlook-pwa-linux"
PACKAGE_NAME="outlook-pwa-linux"
PACKAGE_ARCHITECTURE="amd64"
MICROSOFT_KEY_FINGERPRINT="BC528686B50D79E339D3721CEB3E94ADBE1229CF"
MICROSOFT_KEY_URL="https://packages.microsoft.com/keys/microsoft.asc"
MICROSOFT_EDGE_REPO="https://packages.microsoft.com/repos/edge"

repository=${OUTLOOK_PWA_GITHUB_REPOSITORY:-$DEFAULT_REPOSITORY}
release_base_url=${OUTLOOK_PWA_RELEASE_BASE_URL:-}
allow_test_url=${OUTLOOK_PWA_ALLOW_INSECURE_TEST_URL:-0}
root_mode=0
no_launch=0
download_directory=
package_path=
root_expected_checksum=

usage() {
    cat <<EOF
Usage: ./install-outlook [--no-launch]
       ./install-outlook --download-only DIRECTORY

Download, verify, and install Outlook ${RELEASE_VERSION} for Debian or Ubuntu.
Microsoft Edge and the required desktop libraries are installed automatically.

Options:
  --download-only DIRECTORY  Verify and save the release without installing it
  --no-launch                Do not open Outlook after installation
  --version                  Print the installer version
  -h, --help                 Show this help
EOF
}

fail() {
    echo "install-outlook: $*" >&2
    exit 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --as-root)
            root_mode=1
            shift
            [ "$#" -gt 0 ] || fail "--as-root requires a package path"
            package_path=$1
            shift
            [ "$#" -gt 0 ] || fail "--as-root requires a package checksum"
            root_expected_checksum=$1
            ;;
        --download-only)
            shift
            [ "$#" -gt 0 ] || fail "--download-only requires a directory"
            download_directory=$1
            ;;
        --no-launch)
            no_launch=1
            ;;
        --version)
            printf 'install-outlook %s\n' "$RELEASE_VERSION"
            exit 0
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

validate_platform() {
    command -v apt-get >/dev/null 2>&1 ||
        fail "apt-get was not found; Debian or Ubuntu is required"
    command -v dpkg >/dev/null 2>&1 ||
        fail "dpkg was not found; Debian or Ubuntu is required"
    architecture=$(dpkg --print-architecture)
    [ "$architecture" = "$PACKAGE_ARCHITECTURE" ] ||
        fail "only amd64 systems are currently supported (found $architecture)"
}

validate_package() {
    [ -f "$package_path" ] || fail "package not found: $package_path"
    command -v dpkg-deb >/dev/null 2>&1 ||
        fail "dpkg-deb is required to inspect the package"
    package=$(dpkg-deb --field "$package_path" Package)
    version=$(dpkg-deb --field "$package_path" Version)
    architecture=$(dpkg-deb --field "$package_path" Architecture)
    [ "$package" = "$PACKAGE_NAME" ] ||
        fail "unexpected package name: $package"
    [ "$version" = "$RELEASE_VERSION" ] ||
        fail "unexpected package version: $version"
    [ "$architecture" = "$PACKAGE_ARCHITECTURE" ] ||
        fail "unexpected package architecture: $architecture"
}

restore_browser_alternative() {
    alternative_name=$1
    previous_value=$2
    if [ -n "$previous_value" ] &&
        [ "$previous_value" != "/usr/bin/microsoft-edge-stable" ]; then
        update-alternatives --set "$alternative_name" "$previous_value" || true
    fi
}

install_as_root() {
    [ "$(id -u)" -eq 0 ] ||
        fail "the privileged installation phase must run as root"
    validate_platform

    case "$root_expected_checksum" in
        ''|*[!0-9a-fA-F]*) fail "invalid privileged package checksum" ;;
    esac
    [ "${#root_expected_checksum}" -eq 64 ] ||
        fail "invalid privileged package checksum"

    key_file=$(mktemp)
    package_copy=$(mktemp /tmp/outlook-pwa-linux.XXXXXX.deb)
    # Invoked by the trap below.
    # shellcheck disable=SC2329
    cleanup_root() {
        rm -f -- "$key_file" "$package_copy"
    }
    trap cleanup_root EXIT HUP INT TERM

    install -m 0644 "$package_path" "$package_copy"
    copied_checksum=$(sha256sum "$package_copy" | awk '{ print $1 }')
    [ "$copied_checksum" = "$root_expected_checksum" ] ||
        fail "package changed after verification"
    package_path=$package_copy
    validate_package

    previous_x_browser=$(
        update-alternatives --query x-www-browser 2>/dev/null |
            awk '$1 == "Value:" { print $2; exit }' || true
    )
    previous_gnome_browser=$(
        update-alternatives --query gnome-www-browser 2>/dev/null |
            awk '$1 == "Value:" { print $2; exit }' || true
    )

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl gnupg

    curl --proto '=https' --tlsv1.2 -fsSL "$MICROSOFT_KEY_URL" -o "$key_file"
    downloaded_fingerprint=$(
        gpg --batch --show-keys --with-colons "$key_file" |
            awk -F: '$1 == "fpr" { print $10; exit }'
    )
    [ "$downloaded_fingerprint" = "$MICROSOFT_KEY_FINGERPRINT" ] || {
        echo "Microsoft key fingerprint mismatch." >&2
        echo "Expected: $MICROSOFT_KEY_FINGERPRINT" >&2
        echo "Received: ${downloaded_fingerprint:-none}" >&2
        exit 1
    }

    install -d -m 0755 /etc/apt/keyrings
    gpg --batch --yes --dearmor \
        --output /etc/apt/keyrings/microsoft-edge.gpg "$key_file"
    chmod 0644 /etc/apt/keyrings/microsoft-edge.gpg
    printf '%s\n' \
        "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft-edge.gpg] $MICROSOFT_EDGE_REPO stable main" \
        > /etc/apt/sources.list.d/microsoft-edge-stable.list

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y microsoft-edge-stable
    restore_browser_alternative x-www-browser "$previous_x_browser"
    restore_browser_alternative gnome-www-browser "$previous_gnome_browser"

    if [ -f /etc/apt/sources.list.d/microsoft-edge.sources ] &&
        [ -f /usr/share/keyrings/microsoft-edge.gpg ]; then
        rm -f \
            /etc/apt/sources.list.d/microsoft-edge-stable.list \
            /etc/apt/keyrings/microsoft-edge.gpg
    fi

    DEBIAN_FRONTEND=noninteractive apt-get install -y "$package_copy"
}

if [ "$root_mode" -eq 1 ]; then
    install_as_root
    exit 0
fi

[ "$(id -u)" -ne 0 ] ||
    fail "run this installer as your normal user; it requests elevation when needed"
validate_platform

case "$repository" in
    *[!A-Za-z0-9._/-]*|*/*/*|/*|*/|'')
        fail "invalid GitHub repository: $repository"
        ;;
    */*) ;;
    *) fail "GitHub repository must be in OWNER/REPOSITORY form" ;;
esac

asset_name="${PACKAGE_NAME}_${RELEASE_VERSION}_${PACKAGE_ARCHITECTURE}.deb"
if [ -z "$release_base_url" ]; then
    release_base_url="https://github.com/$repository/releases/download/v$RELEASE_VERSION"
fi

case "$release_base_url" in
    https://*) ;;
    *)
        [ "$allow_test_url" = "1" ] ||
            fail "refusing a non-HTTPS release URL"
        ;;
esac

temporary_directory=$(mktemp -d)
# Invoked by the trap below.
# shellcheck disable=SC2329
cleanup_download() {
    rm -rf -- "$temporary_directory"
}
trap cleanup_download EXIT HUP INT TERM
downloaded_package="$temporary_directory/$asset_name"
downloaded_checksums="$temporary_directory/SHA256SUMS"

download() {
    source_url=$1
    destination=$2
    if command -v curl >/dev/null 2>&1; then
        if [ "$allow_test_url" = "1" ]; then
            curl -fsSL "$source_url" -o "$destination"
        else
            curl --proto '=https' --tlsv1.2 -fsSL "$source_url" -o "$destination"
        fi
    elif command -v wget >/dev/null 2>&1; then
        [ "$allow_test_url" != "1" ] ||
            fail "test URLs require curl"
        wget --https-only --secure-protocol=TLSv1_2 -qO "$destination" "$source_url"
    else
        fail "curl or wget is required to download the release"
    fi
}

printf 'Downloading Outlook %s…\n' "$RELEASE_VERSION"
download "$release_base_url/$asset_name" "$downloaded_package"
download "$release_base_url/SHA256SUMS" "$downloaded_checksums"

expected_checksum=$(
    awk -v filename="$asset_name" '
        $2 == filename || $2 == "*" filename { print $1; exit }
    ' "$downloaded_checksums"
)
case "$expected_checksum" in
    '') fail "release checksum for $asset_name was not found" ;;
    *[!0-9a-fA-F]*) fail "invalid checksum for $asset_name" ;;
esac
[ "${#expected_checksum}" -eq 64 ] ||
    fail "invalid checksum for $asset_name"
actual_checksum=$(sha256sum "$downloaded_package" | awk '{ print $1 }')
[ "$actual_checksum" = "$expected_checksum" ] ||
    fail "release checksum verification failed"
printf 'Verified %s\n' "$asset_name"

package_path=$downloaded_package
validate_package

if [ -n "$download_directory" ]; then
    mkdir -p -- "$download_directory"
    install -m 0644 "$downloaded_package" "$download_directory/$asset_name"
    install -m 0644 "$downloaded_checksums" "$download_directory/SHA256SUMS"
    printf 'Saved verified release files to %s\n' "$download_directory"
    exit 0
fi

script_path=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")
if command -v pkexec >/dev/null 2>&1; then
    pkexec "$script_path" \
        --as-root "$package_path" "$actual_checksum" --no-launch
elif command -v sudo >/dev/null 2>&1; then
    sudo "$script_path" \
        --as-root "$package_path" "$actual_checksum" --no-launch
else
    fail "neither pkexec nor sudo is available for administrator authentication"
fi

if [ "$no_launch" -eq 0 ]; then
    /usr/bin/outlook-pwa
    printf '\nOutlook is installed. Complete Microsoft sign-in in the window that opens.\n'
else
    printf '\nOutlook is installed.\n'
fi
